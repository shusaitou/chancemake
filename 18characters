##パスアクションの集中度
import pandas as pd

# パス経路内のパスイベントを取得
pass_events = possession_data[possession_data['event_type'] == 'pass']

# 各プレイヤーのパスアクションの回数をカウント
pass_counts = pass_events['player_id'].value_counts()

# 最大パス回数と該当プレイヤーID
N_p_star = pass_counts.max()
player_p_star = pass_counts.idxmax()

# プレイヤー数
n = len(pass_counts)

# 分子の計算
numerator = sum(N_p_star - pass_counts)

# 分母の計算
denominator = N_p_star * (n - 1)

# パスアクションの集中度の計算
centralization_of_passing_actions = numerator / denominator if denominator != 0 else 0






##ポゼッションタイムの集中度
# 各プレイヤーのボール保持時間を計算（イベントの持続時間の合計）
possession_time_by_player = possession_events.groupby('player_id')['event_duration'].sum()

# 最大ボール保持時間と該当プレイヤーID
T_p_star = possession_time_by_player.max()
player_p_star = possession_time_by_player.idxmax()

# プレイヤー数
n = len(possession_time_by_player)

# 分子の計算
numerator = sum(T_p_star - possession_time_by_player)

# 分母の計算
denominator = T_p_star * (n - 1)

# ボール保持時間の集中度の計算
centralization_of_possession_time = numerator / denominator if denominator != 0 else 0